<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
    <Dialog title="{i18n>changeFrameTitle}" contentWidth="26rem" draggable="true" stretch="{device>/system/phone}">
        <f:SimpleForm editable="true" layout="ColumnLayout" columnsM="1" columnsL="1" columnsXL="1">
            <Label text="{i18n>currentFrame}"/>
            <Text text="{change>/row/frameno}"/>
            <Label text="{i18n>currentEngine}"/>
            <Text text="{change>/row/engineno}"/>
            <Label text="{i18n>newFrame}" required="true"/>
            <Input value="{change>/frameno}" showValueHelp="true" valueHelpOnly="true" valueHelpRequest=".onNewFrameHelp"/>
            <Label text="{i18n>newEngine}"/>
            <Input value="{change>/engineno}" editable="false"/>
        </f:SimpleForm>
        <beginButton>
            <Button text="{i18n>change}" type="Emphasized" press=".onChangeConfirm" enabled="{= !!${change>/frameno} }"/>
        </beginButton>
        <endButton>
            <Button text="{i18n>cancel}" press=".onChangeCancel"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
