<mvc:View controllerName="hmcl.form22ui.controller.Frames"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page id="framesPage" showHeader="false" backgroundDesign="List" enableScrolling="true"
        busy="{view>/busy}" busyIndicatorDelay="300">
        <content>
            <VBox visible="{view>/preview}">
                <MessageStrip text="{view>/printInfo}" type="Success" showIcon="true" class="sapUiSmallMargin"/>
                <OverflowToolbar>
                    <Button text="{i18n>close}" icon="sap-icon://decline" press=".onClosePreview"/>
                    <Select items="{view>/pdfs}" change=".onPdfSelect" visible="{= ${view>/pdfs}.length > 1 }">
                        <core:Item key="{view>name}" text="{view>name}"/>
                    </Select>
                    <ToolbarSpacer/>
                    <!-- phones cannot show a PDF inside the page: open it in the browser's own viewer -->
                    <Button text="{i18n>openPdf}" icon="sap-icon://pdf-attachment" press=".onOpenPdf"/>
                </OverflowToolbar>
                <core:HTML id="pdfFrame" content=""/>
            </VBox>
            <VBox visible="{= !${view>/preview} }">
                <OverflowToolbar style="Clear">
                    <Button icon="sap-icon://nav-back" type="Transparent" tooltip="{i18n>back}" press=".onBack"/>
                    <Title text="{i18n>frameDetails}" level="H2"/>
                    <ToolbarSpacer/>
                    <Button text="{i18n>print}" icon="sap-icon://print" type="Emphasized" press=".onPrint"
                        enabled="{= ${view>/selCount} > 0 }"/>
                    <Button text="{i18n>change}" icon="sap-icon://edit" press=".onChange"
                        enabled="{= ${view>/selCount} === 1 }"/>
                </OverflowToolbar>
                <!-- wraps onto two lines on phones instead of cutting the numbers off -->
                <FlexBox wrap="Wrap" class="sapUiSmallMarginBeginEnd sapUiTinyMarginBottom">
                    <ObjectAttribute title="{i18n>invoiceNumber}" text="{view>/invoice}" class="sapUiMediumMarginEnd sapUiTinyMarginBottom"/>
                    <ObjectAttribute title="{i18n>vinNumber}" text="{view>/frame}" class="sapUiTinyMarginBottom"/>
                </FlexBox>
                <MessageStrip text="{view>/error}" type="Warning" showIcon="true"
                    visible="{= !!${view>/error} }" class="sapUiSmallMargin"/>
                <Table id="frames" items="{view>/rows}" noDataText="{i18n>noData}" popinLayout="GridSmall">
                    <columns>
                        <Column width="4rem" hAlign="Center"><Text text="{i18n>select}"/></Column>
                        <Column><Text text="{i18n>model}"/></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>frameNumber}"/></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>engineNumber}"/></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>printStatus}"/></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <CheckBox selected="{view>selected}" enabled="{view>printable}" select=".onSelect"/>
                                <Text text="{view>model}"/>
                                <Text text="{view>frameno}"/>
                                <Text text="{view>engineno}"/>
                                <ObjectStatus text="{view>status}" state="{= ${view>printable} ? 'Information' : 'Success' }"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>
