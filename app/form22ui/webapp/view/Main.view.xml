<mvc:View controllerName="hmcl.form22ui.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form">
    <Page id="mainPage" showHeader="false" backgroundDesign="Solid" showFooter="{session>/authorized}"
        busy="{session>/loading}" busyIndicatorDelay="0">
        <content>
            <IllustratedMessage illustrationType="sapIllus-UnableToLoad" title="{i18n>accessDenied}"
                description="{session>/error}" visible="{= !!${session>/error} }"/>
            <!-- labels left of the fields on tablet/desktop, above them on phones -->
            <f:SimpleForm id="invoiceForm" editable="true" layout="ResponsiveGridLayout" visible="{session>/authorized}"
                labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12" adjustLabelSpan="false"
                emptySpanXL="5" emptySpanL="4" emptySpanM="2" emptySpanS="0"
                columnsXL="1" columnsL="1" columnsM="1" singleContainerFullSize="false">
                <f:toolbar>
                    <Toolbar>
                        <Title text="{i18n>invoiceDetails}" level="H2"/>
                        <ToolbarSpacer/>
                        <Button icon="sap-icon://refresh" type="Transparent" tooltip="{i18n>refresh}" press=".onRefresh"/>
                    </Toolbar>
                </f:toolbar>
                <f:content>
                    <Label text="{i18n>dealerCode}" required="true"/>
                    <Input id="dealer" value="{view>/kunnr}" maxLength="10"
                        placeholder="{i18n>dealerPlaceholder}"
                        editable="{session>/isEditable}" showValueHelp="true"
                        valueHelpRequest=".onDealerHelp" change=".onDealerChange"
                        valueState="{view>/dealerState}" valueStateText="{view>/dealerError}"/>

                    <Label text="{i18n>dealerName}" visible="{= !!${view>/name1} }"/>
                    <Text text="{view>/name1}" visible="{= !!${view>/name1} }"/>

                    <Label text="{i18n>invoiceNumber}" required="true"/>
                    <Input id="invoice" value="{view>/invoice}" maxLength="10"
                        placeholder="{i18n>invoicePlaceholder}"
                        editable="{= ${view>/step} === 1 }" showValueHelp="true"
                        valueHelpRequest=".onInvoiceHelp" change=".onInvoiceChange" submit=".onContinue"
                        valueState="{view>/invoiceState}" valueStateText="{view>/invoiceError}"/>

                    <Label text="{i18n>vinNumber}" required="true" visible="{= ${view>/step} === 2 }"/>
                    <Input id="vin" value="{view>/frame}" maxLength="17" visible="{= ${view>/step} === 2 }"
                        placeholder="{i18n>vinPlaceholder}"
                        showValueHelp="true"
                        valueHelpRequest=".onVinHelp" change=".onFrameChange" submit=".onProceed"
                        valueState="{view>/frameState}" valueStateText="{view>/frameError}"/>
                </f:content>
            </f:SimpleForm>
        </content>
        <footer>
            <OverflowToolbar>
                <ToolbarSpacer/>
                <Button text="{i18n>continue}" type="Emphasized" press=".onContinue"
                    visible="{= ${view>/step} === 1 }"/>
                <Button text="{i18n>proceed}" type="Emphasized" press=".onProceed"
                    visible="{= ${view>/step} === 2 }"/>
                <Button text="{i18n>changeInvoice}" press=".onChangeInvoice"
                    visible="{= ${view>/step} === 2 }"/>
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
